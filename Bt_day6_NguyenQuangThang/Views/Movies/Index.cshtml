@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Danh sách phim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 page-heading mb-0">Danh sách phim</h1>
    <a class="btn btn-success" asp-action="Create">+ Thêm phim</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle bg-white">
        <thead class="table-success"><tr><th>Tên phim</th><th>Ngày phát hành</th><th>Thời lượng</th><th>Thể loại</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td class="fw-semibold">@movie.Title</td>
                <td>@movie.ReleaseDate.ToString("dd/MM/yyyy")</td>
                <td>@movie.Duration phút</td>
                <td>@movie.Genre?.Name</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@movie.Id">Sửa</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@movie.Id">Xóa</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>